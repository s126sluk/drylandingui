//- Blog layout. Wraps a post's `block article` in the real site chrome by
//- extending the shared site layout and reusing the live header, footer, CSS
//- and fonts. Not compiled as a page itself (the blog task excludes _*.pug).
//-
//- Assets in the shared layout are root-relative (css/…, img/…, js/…), which
//- would break for a page served at /blog/<slug>/. `base href="/"` (emitted
//- before the stylesheet link via prepend head) makes every relative URL
//- resolve from the site root instead, so no layout edit is needed.
//-
//- Image slot: a post's optional hero image comes from src/blog/posts.js
//- (`image` = filename in /img/blog/, `alt` = required alt text). It renders
//- above the article and also feeds og:image. A post with no image renders
//- normally; an image with no alt fails the build loudly.
//-
//- Expects the extending page to set, in its own `prepend head`:
//-   slug, pageTitle, pageDescription   (posts look these up from posts.js)
extends ../templates/settings/layout

prepend html
  - const lang = "en"

prepend head
  base(href="/")
  - const pageKeywords = ""
  - const themeColor = "#ffffff"

append head
  link(rel="canonical", href="https://drysafe.sydney/blog/" + slug + (slug ? "/" : ""))
  - var _og = (typeof posts !== 'undefined' ? posts : []).find(function (p) { return p.slug === slug; }) || {}
  - if (_og.image && !_og.alt) throw new Error('Blog post "' + (slug || 'index') + '" sets image "' + _og.image + '" but has no alt text — alt is required.')
  if _og.image
    meta(property="og:image", content="https://drysafe.sydney/img/blog/" + _og.image)
    meta(property="og:image:alt", content=_og.alt)

append content
  include ../templates/mixins/btn
  .site-header
    include ../templates/components/header
  main
    section.block
      .container
        - var _hero = (typeof posts !== 'undefined' ? posts : []).find(function (p) { return p.slug === slug; }) || {}
        if _hero.image
          img.blog-post__hero(src="/img/blog/" + _hero.image, alt=_hero.alt, width="2400", height="1350")
        block article
  include ../templates/components/footer
