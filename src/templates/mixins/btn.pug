//- ── Centralized primary-CTA destination (item 7) ──────────────────
//- ONE place to change the funnel destination. The coming funnel-wiring
//- flip is a one-line edit here. Value stays exactly what is live today.
//- Every primary CTA below routes through this, so the href always contains
//- "drysafe.vercel.app" and clickforward.js keeps firing PostHog cta_clickthrough.
//- [CP4] Overridable per page: mould page routes primary CTAs to its on-page
//- packages section (#packages) instead of the funnel. Water pages unchanged.
- var CTA_HREF = (typeof ctaHrefOverride !== 'undefined') ? ctaHrefOverride : 'https://drysafe.vercel.app/get-started'

mixin btn(classes, text)
  a(class=classes, href=CTA_HREF)&attributes(attributes)
    span= text

//- ── v3 primary CTA (Option 2) ─────────────────────────────────────
//- Right-arrow chevron used inside the label.
mixin ctaArrow
  svg.cta__arrow(width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true")
    path(d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round")

//- Primary CTA. `sub` = optional white price sub-line (hero only; falsy = omit).
mixin ctaPrimary(classes, sub)
  //- [CP4] Label + sub-line overridable per page (mould: 'Book now', no sub).
  - var _ctaLabel = (typeof ctaLabel !== 'undefined') ? ctaLabel : 'Lock in my arrival time'
  - var _suppressSub = (typeof ctaSuppressSub !== 'undefined' && ctaSuppressSub)
  a.cta(class=classes, href=CTA_HREF)&attributes(attributes)
    span.cta__label
      = _ctaLabel
      +ctaArrow
    if sub && !_suppressSub
      span.cta__sub= sub

//- Stripe trust microline — hero only, rendered beneath the button.
mixin ctaTrust
  .cta-trust
    svg.cta-trust__icon(width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true")
      rect(x="4" y="10" width="16" height="11" rx="2.5" stroke="currentColor" stroke-width="2")
      path(d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2")
    | Secure Stripe checkout

//- Compact top-nav CTA. Single line, never wraps.
//- [CP4 v5-spec] On the mould page the header Book Now is a PURE MODAL TRIGGER
//- (drySafe Care preselected) — data-mpk-open is bound in mouldPackages.js.
//- href stays as the #packages anchor for no-JS fallback. Water unchanged.
mixin navBtn(classes)
  if (typeof isMould !== 'undefined' && isMould)
    a.navbtn(class=classes, href=CTA_HREF, data-mpk-open="care")&attributes(attributes)
      | Book now
  else
    a.navbtn(class=classes, href=CTA_HREF)&attributes(attributes)
      | Book now

//- SMS fallback panel (3 placements only: hero, mid, final).
//- "nearly 40%" — the word "nearly" must ALWAYS precede "40%" (ACL/ACCC).
//-
//- [v4] Option B "action chip". Was a single whole-panel <a> with the deeplink
//- on the container and the phone number buried mid-sentence in the hook — a
//- tap target with no affordance. Now: hook → subtext → chip, where the chip is
//- the anchor and carries the sms: href UNCHANGED, moved verbatim off the old
//- container. Panel itself is now a plain div.
//-
//- `placement` is hero | mid | final and rides through to the
//- sms_deeplink_tap PostHog event via data-sms-placement (see js/modules/smsdeeplink).
//-
//- [CP4] Keyword is service-aware: MOULD routes Twilio to the mould package
//- link; PRICE stays the water path. "nearly 40%" wording frozen (ACL/ACCC) —
//- percentage itself to be re-verified against mould pricing before launch.
//- On water pages _smsKw is 'PRICE', so the rendered markup is unchanged.
mixin smsPanel(placement)
  - var _smsKw = (typeof isMould !== 'undefined' && isMould) ? 'MOULD' : 'PRICE'
  .sms-panel&attributes(attributes)
    span.sms-panel__hook Not ready yet? Save nearly 40%
    span.sms-panel__sub We'll lock in your online price and send a link so you can book anytime in the next 24 hours — even if you want to shop around first.
    a.sms-chip(href="sms:+61485077233?&body=" + _smsKw, data-sms-placement=placement)
      svg.sms-chip__icon(width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true")
        path(d="M21 12c0 4.1-4 7.4-9 7.4-1 0-2-.13-2.9-.38L4 21l1.6-3.6C4 16 3 14.1 3 12c0-4.1 4-7.4 9-7.4s9 3.3 9 7.4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round")
      span.sms-chip__label Text #{_smsKw} to 0485-07-SAFE
      svg.sms-chip__arrow(width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true")
        path(d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round")
