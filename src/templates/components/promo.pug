section.promo.block
    .container
        .promo__inner
            //- 2–7. Content block: ratings → headline → CTA → price → SMS → trust
            //- [A2] Content now precedes the gallery in source so mobile renders H1 first.
            .promo__content
                //- 1.2 — Google ratings condensed to one line
                .google-ratings
                    .rating(style="--star-rating: 5")
                    img.google-ratings__icon(src="img/google-icon.svg", alt="Google")
                    span.google-ratings__label Google Reviews — 5.0 Rating

                //- [A5] Headline reframed to the booking-confirmation promise.
                //- [A1] Variant pages override heroTitle/heroSubhead; main page uses the defaults.
                - var _heroTitle = (typeof heroTitle !== 'undefined') ? heroTitle : "Book now. Get your arrival time locked in, in just a few seconds"
                - var _heroSubhead = (typeof heroSubhead !== 'undefined') ? heroSubhead : "Sydney's certified water damage crews. Fixed package prices and a real dispatch time confirmed the moment you book."
                h1.promo__title= _heroTitle

                //- [A2] Sydney surfaced above the fold in the supporting subhead
                .promo__description= _heroSubhead

                //- [A4] Primary CTA
                .promo__btn
                    +btn('btn btn-primary btn-rounded btn-large promo__cta', 'Book Now — See Prices')
                .promo__btn-note.text-center Booked in about 60 seconds · fixed package prices · confirmation the moment you book

                //- [A3] Price anchor adjacent to the primary CTA, above the fold
                .promo__price
                    span.promo__price-tag Packages from <b>$302</b> per room

                //- [A4/SMS] Secondary CTA — display + sms: deeplink (modal behaviour is the separate SMS spec)
                .promo__sms
                    +smsCta('promo__sms-link')

                //- [A5] Response time demoted to a single soft supporting line
                .promo__soft.text-center Crews typically on-site within the hour.

                //- Trust indicators / risk reduction
                .promo__trust
                    .promo__preference
                        include preference
                    .promo__advantages
                        include advantages

            //- 1. Before/after image carousel + testimonials
            //- [A2] Gallery moved below the CTA block (was first in source, buried the H1 on mobile).
            .promo__gallery
                include gallery

                //- Testimonial snippets — compact social proof below carousel
                .promo__snippets
                    .snippet
                        img.snippet__avatar(src="img/review-ava-1.jpg", alt="Leora Segal")
                        .snippet__body
                            .snippet__text "The guys were very professional. Explained things well. Very quick to respond and get on with job."
                            .snippet__meta
                                .snippet__stars
                                    .rating(style="--star-rating: 5;")
                                .snippet__name Leora Segal
                                img.snippet__google(src="img/google-icon.svg", alt="Google")
                    .snippet
                        img.snippet__avatar(src="img/review-ava-2.jpg", alt="Phil Kells")
                        .snippet__body
                            .snippet__text "They are professional and friendly and keep their promises & commitments. Seems simple, but it's not ..."
                            .snippet__meta
                                .snippet__stars
                                    .rating(style="--star-rating: 5;")
                                .snippet__name Phil Kells
                                img.snippet__google(src="img/google-icon.svg", alt="Google")
                    .snippet
                        img.snippet__avatar(src="img/review-ava-3.jpg", alt="Kim Crumpton")
                        .snippet__body
                            .snippet__text "Promptly contacted us after our insurance claim was lodged. Followed up, and came out to ...."
                            .snippet__meta
                                .snippet__stars
                                    .rating(style="--star-rating: 5;")
                                .snippet__name Kim Crumpton
                                img.snippet__google(src="img/google-icon.svg", alt="Google")
                    .snippet
                        img.snippet__avatar(src="img/review-ava-4.jpg", alt="Yona Griffin")
                        .snippet__body
                            .snippet__text "It was a relief to have them attend and get our premises to a usable state so quickly"
                            .snippet__meta
                                .snippet__stars
                                    .rating(style="--star-rating: 5;")
                                .snippet__name Yona Griffin
                                img.snippet__google(src="img/google-icon.svg", alt="Google")
