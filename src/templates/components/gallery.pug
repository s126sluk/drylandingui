        .swiper-wrapper
            //- Pair 1 — bathroom flood (LCP slide: eager + preloaded in layout head)
            .swiper-slide
                .work
                    .work__item.work__item--before
                        img.work__img(src="img/ba1-bathroom-before.jpg", alt="Water-damaged bathroom floor before drying — real drySafe job")
                    .work__item.work__item--after
                        img.work__img(src="img/ba1-bathroom-after.jpg", alt="Bathroom dried with drySafe equipment — real drySafe job")
