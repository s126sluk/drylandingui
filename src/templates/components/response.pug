section.response.block 
	.container 
		.response-grid 
			.response-grid__title 
				- var _respTitle = (typeof isMould !== 'undefined' && isMould) ? 'Treated <span class="text-blue">properly</span>' : 'Fast response <span class="text-blue">time</span>'
				h2.response__title.text-uppercase.mb-0.text-center.text-lg-left!= _respTitle
			.response-grid__img
				img.img-rounded.response__img(loading="lazy", src="img/response-img.jpg" alt="")
			.response-grid__description
				- var _respBody = (typeof isMould !== 'undefined' && isMould) ? 'Mould is not a cleaning problem — wiping it away leaves spores behind and it returns within weeks. Our technicians follow a controlled remediation sequence — HEPA vacuum of the surface, then a TGA-listed anti-microbial application. Furniture is protected throughout, and every treated surface is photographed before and after.' : 'Every minute counts with water damage. Within 24 hours, water penetrates deeper into building materials, mould spores germinate, and structural damage accelerates. Our Sydney-based technicians arrive within 60 minutes on average — extracting water and starting the drying process before the damage compounds. Faster response means lower costs and faster recovery for you.'
				.response__description= _respBody
			.response-grid__btn
				.response__btn.text-center.text-lg-left
					unless (typeof isMould !== 'undefined' && isMould)
						+ctaPrimary('')
		//- [CP4 v9] Picker lives OUTSIDE the legacy grid as a full-width band —
		//- inside a grid cell it crushed to column width (SS88 screenshots 11 Aug)
		if (typeof isMould !== 'undefined' && isMould)
			.picker-band
				+mouldPicker('s3')