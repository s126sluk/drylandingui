//- 3.1 — Before/after pain point section
//- [v4] Now uses the real job photos (ba1–ba3, shared with the hero carousel —
//- same files, no duplicates). Suburb attributions were removed with the old
//- AI-generated images: they were illustrative, and against a real photo they
//- would read as a location claim. Copy describes only what is visible in the
//- frame — no suburb, no timeframe, no invented detail.
section.painpoint.block
    .container
        h2.painpoint__title.text-uppercase.text-center See the Damage We <span class="text-blue">Reverse Every Day</span>
        p.painpoint__subtitle.text-center Water damage doesn't wait — and neither do we. Here's what fast, professional restoration looks like.
        .painpoint__grid
            .painpoint__card
                .painpoint__images
                    .painpoint__img.painpoint__img--before
                        img(loading="lazy", src="img/ba1-bathroom-before.jpg", alt="Standing water across a tiled bathroom floor before drying — real drySafe job")
                        span.painpoint__label Before
                    .painpoint__img.painpoint__img--after
                        img(loading="lazy", src="img/ba1-bathroom-after.jpg", alt="The same bathroom floor dry, with drySafe drying equipment running — real drySafe job")
                        span.painpoint__label After
                .painpoint__context
                    h3.painpoint__heading Flooded Bathroom — Standing Water on the Floor
                    p.painpoint__detail Water pooled across the tiled bathroom floor and spread out toward the doorway. We extracted it and left drying equipment running on site until the floor was dry.
            .painpoint__card
                .painpoint__images
                    .painpoint__img.painpoint__img--before
                        img(loading="lazy", src="img/ba2-apartment-before.jpg", alt="Saturated beige carpet in an apartment living area before drying — real drySafe job")
                        span.painpoint__label Before
                    .painpoint__img.painpoint__img--after
                        img(loading="lazy", src="img/ba2-apartment-after.jpg", alt="Apartment living area with a drySafe dehumidifier running on the dried carpet — real drySafe job")
                        span.painpoint__label After
                .painpoint__context
                    h3.painpoint__heading Soaked Carpet in an Apartment Living Area
                    p.painpoint__detail Water spread through the living-area carpet and left it saturated underfoot. We set a dehumidifier up on site and ran it until the carpet was dry again.
            .painpoint__card
                .painpoint__images
                    .painpoint__img.painpoint__img--before
                        img(loading="lazy", src="img/ba3-carpet-before.jpg", alt="Wet patches along an apartment hallway carpet before drying — real drySafe job")
                        span.painpoint__label Before
                    .painpoint__img.painpoint__img--after
                        img(loading="lazy", src="img/ba3-carpet-after.jpg", alt="Hallway and bedroom carpet dried with drySafe air movers and a dehumidifier — real drySafe job")
                        span.painpoint__label After
                .painpoint__context
                    h3.painpoint__heading Wet Carpet Running Down an Apartment Hallway
                    p.painpoint__detail Water soaked its way along the hallway carpet and through into the bedroom. Air movers and a dehumidifier ran across both rooms until the carpet was dry.
        .painpoint__btn.text-center
            +ctaPrimary('')
