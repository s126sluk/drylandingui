section.community.block 
	.container 
		- var _commPain = (typeof isMould !== 'undefined' && isMould) ? "we've seen first-hand how stressful finding mould in your home can be" : "we've seen first-hand how stressful water damage can be"
		.community-grid 
			.community-grid__title 
				h2.community__title.text-uppercase.mb-0.text-center.text-lg-left LOCAL EXPERTS PROUDLY <span class="text-blue">SERVING OUR COMMUNITY</span>
			.community-grid__img
				img.img-rounded.community__img(loading="lazy", src="img/community-img-1.jpg" alt="")
				img.img-rounded.community__img(loading="lazy", src="img/community-img-2.jpg" alt="")
			.community-grid__description
				.community__description Founded in Sydney, DrySafe is built on a commitment to protect our neighbours. We live and work in the same communities we serve — and #{_commPain}. When you choose DrySafe, you're choosing a local business that genuinely cares about this city and the people in it.
			.community-grid__btn
				.community__btn.text-center.text-lg-left
					unless (typeof isMould !== 'undefined' && isMould)
						+ctaPrimary('')
		//- [CP4 v9] Picker lives OUTSIDE the legacy grid as a full-width band —
		//- inside a grid cell it crushed to column width (SS88 screenshots 11 Aug)
		if (typeof isMould !== 'undefined' && isMould)
			.picker-band
				+mouldPicker('s2')